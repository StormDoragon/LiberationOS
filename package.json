{
  "name": "liberation-os",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @liberation-os/web dev",
    "dev:worker": "pnpm --filter @liberation-os/worker dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "worker": "pnpm --filter @liberation-os/worker dev",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "pnpm --filter @liberation-os/db seed",
    "db:push": "turbo run db:push",
    "db:studio": "pnpm --filter @liberation-os/db prisma:studio",
    "setup": "pnpm install && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "start:web": "pnpm --filter @liberation-os/web start",
    "start:worker": "pnpm --filter @liberation-os/worker start",
    "db:deploy": "pnpm --filter @liberation-os/db prisma:deploy",
    "db:schema:check": "node scripts/check-prisma-schema-sync.mjs",
    "clean": "turbo clean && rm -rf node_modules/.cache .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3"
  }
}
