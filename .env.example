# Core services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liberation_os?schema=public
REDIS_URL=redis://127.0.0.1:6379
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=replace-with-a-random-auth-secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 32-byte AES key encoded as 64 hex characters or base64
ENCRYPTION_KEY=

# Worker / queue tuning
WORKER_CONCURRENCY=2
WORKFLOW_JOB_ATTEMPTS=3
WORKFLOW_JOB_BACKOFF_MS=5000
WORKFLOW_REMOVE_ON_COMPLETE=100
WORKFLOW_REMOVE_ON_FAIL=100

# AI — optional; system uses deterministic offline fallbacks without a key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LLM_BASE_URL=

# Future provider keys (not currently used by ai-core)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Publishing integrations — optional
WORDPRESS_API_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
BUFFER_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Object storage placeholders — optional
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Production Docker Compose defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=liberation_os
